<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trampaki — Keynote Pitch</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a0c;
      --bg-surface: #101116;
      --bg-card: rgba(18, 20, 26, 0.88);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-highlight: rgba(255, 45, 122, 0.45);
      --accent: #ff2d7a;
      --accent-glow: rgba(255, 45, 122, 0.38);
      --gemini-cyan: #38bdf8;
      --text: #f3f4f6;
      --text-muted: #9ca3af;
      --text-dim: #4b5563;
      --stage-yellow: #facc15;
      --stage-red: #ef4444;
      --stage-green: #10b981;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
    }

    /* VIEWPORT DISPLAY ROUTING */
    body.is-presenter-mode #audienceViewport {
      display: none !important;
    }

    body.is-presenter-mode #presenterViewport {
      display: grid !important;
    }

    body.is-preview-mode #audienceHint,
    body.is-preview-mode .brand-mark {
      display: none !important;
    }

    /* AUDIENCE KEYNOTE PRESENTATION */
    #audienceViewport {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .ambient-canvas {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }

    .ambient-glow-1 {
      position: absolute;
      width: 75vw;
      height: 75vw;
      max-width: 880px;
      max-height: 880px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--accent-glow) 0%, rgba(255, 45, 122, 0.04) 45%, transparent 70%);
      filter: blur(85px);
      top: -20%;
      right: -12%;
      opacity: 0.65;
      animation: driftGlow 24s ease-in-out infinite alternate;
    }

    .ambient-glow-2 {
      position: absolute;
      width: 65vw;
      height: 65vw;
      max-width: 720px;
      max-height: 720px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.16) 0%, transparent 65%);
      filter: blur(95px);
      bottom: -15%;
      left: -10%;
      opacity: 0.45;
      animation: driftGlow2 30s ease-in-out infinite alternate;
    }

    .grid-overlay {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.032) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(circle at 50% 50%, black 45%, transparent 90%);
      -webkit-mask-image: radial-gradient(circle at 50% 50%, black 45%, transparent 90%);
      opacity: 0.8;
    }

    @keyframes driftGlow {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-15%, 8%) scale(1.08); }
    }

    @keyframes driftGlow2 {
      0% { transform: translate(0, 0) scale(0.95); }
      100% { transform: translate(14%, -14%) scale(1.06); }
    }

    .brand-mark {
      position: fixed;
      top: clamp(16px, 3.2vw, 36px);
      left: clamp(20px, 4vw, 56px);
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: clamp(11px, 0.9vw, 13px);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.45);
      pointer-events: none;
    }

    .brand-mark .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
    }

    .audience-hint {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: rgba(16, 17, 24, 0.92);
      border: 1px solid var(--border-subtle);
      border-radius: 9999px;
      padding: 9px 20px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      z-index: 50;
      backdrop-filter: blur(14px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .audience-hint.visible {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .key-badge {
      display: inline-block;
      padding: 1px 6px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      color: #fff;
      font-weight: 600;
      margin: 0 2px;
    }

    /* SCENE STRUCTURE & ANIMATIONS */
    .stage-container {
      position: relative;
      width: 100%;
      height: 100%;
      z-index: 10;
    }

    .scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: clamp(24px, 6vw, 76px) clamp(24px, 7vw, 108px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: scale(0.985);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s;
    }

    .scene.active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: scale(1);
    }

    .stagger-item {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .scene.active .stagger-1 { opacity: 1; transform: translateY(0); transition-delay: 0.1s; }
    .scene.active .stagger-2 { opacity: 1; transform: translateY(0); transition-delay: 0.24s; }
    .scene.active .stagger-3 { opacity: 1; transform: translateY(0); transition-delay: 0.38s; }
    .scene.active .stagger-4 { opacity: 1; transform: translateY(0); transition-delay: 0.52s; }
    .scene.active .stagger-5 { opacity: 1; transform: translateY(0); transition-delay: 0.66s; }

    .kicker {
      font-family: var(--font-mono);
      font-size: clamp(11px, 1vw, 13px);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: var(--accent);
      margin-bottom: clamp(12px, 2vh, 22px);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .kicker::after {
      content: '';
      flex: 0 0 36px;
      height: 1px;
      background: var(--accent);
      opacity: 0.4;
    }

    .display-title {
      font-size: clamp(34px, 5.2vw, 84px);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.04em;
      max-width: 20ch;
      margin-bottom: clamp(16px, 2.5vh, 28px);
      color: #fff;
    }

    .sub-support {
      font-size: clamp(16px, 2vw, 24px);
      line-height: 1.45;
      color: var(--text-muted);
      max-width: 44ch;
      font-weight: 400;
    }

    /* SCENE 1: HOOK */
    .strikethrough-reveal {
      position: relative;
      display: inline-block;
      color: var(--text-dim);
      transition: color 0.4s ease 0.8s;
    }

    .strikethrough-reveal::after {
      content: '';
      position: absolute;
      top: 52%;
      left: -2%;
      width: 0%;
      height: 3px;
      background: var(--accent);
      transform: translateY(-50%) rotate(-1deg);
      transition: width 0.7s cubic-bezier(0.65, 0, 0.35, 1) 0.8s;
      border-radius: 2px;
      box-shadow: 0 0 8px var(--accent-glow);
    }

    .scene.active .strikethrough-reveal::after {
      width: 104%;
    }

    .scene.active .strikethrough-reveal {
      color: #6b7280;
    }

    .real-answer {
      color: #ffffff;
      font-weight: 800;
      display: inline-block;
      margin-left: clamp(8px, 1.2vw, 18px);
      opacity: 0;
      transform: translateX(12px);
      transition: opacity 0.5s ease 1.35s, transform 0.5s ease 1.35s;
    }

    .scene.active .real-answer {
      opacity: 1;
      transform: translateX(0);
    }

    /* SCENE 2: TWO COL CHAOS */
    .two-col-layout {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(32px, 5vw, 80px);
      align-items: center;
      width: 100%;
    }

    @media (max-width: 900px) {
      .two-col-layout {
        grid-template-columns: 1fr;
      }
      .fragments-cloud {
        opacity: 0.35;
        position: absolute;
        inset: 0;
        z-index: -1;
      }
    }

    .fragments-cloud {
      position: relative;
      min-height: 420px;
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      align-content: center;
      justify-content: center;
      gap: 13px;
      padding: 16px;
    }

    .fragment-tag {
      font-family: var(--font-mono);
      font-size: clamp(11px, 0.9vw, 13px);
      padding: 8px 14px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #d1d5db;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      animation: floatTag 6s ease-in-out infinite alternate;
    }

    .fragment-tag .tag-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 45, 122, 0.6);
    }

    .fragment-tag:nth-child(2n) { animation-duration: 7.4s; animation-delay: -1.2s; }
    .fragment-tag:nth-child(3n) { animation-duration: 8.8s; animation-delay: -2.8s; }
    .fragment-tag:nth-child(4n) { animation-duration: 6.6s; animation-delay: -4s; }

    @keyframes floatTag {
      0% { transform: translateY(0); }
      100% { transform: translateY(-12px); }
    }

    /* SCENE 3: PERSONA */
    .persona-quote-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-left: 4px solid var(--accent);
      border-radius: 18px;
      padding: clamp(24px, 4vw, 44px);
      max-width: 900px;
      margin-bottom: clamp(20px, 3vh, 34px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }

    .persona-quote {
      font-size: clamp(20px, 2.8vw, 36px);
      font-weight: 700;
      line-height: 1.25;
      color: #fff;
      letter-spacing: -0.02em;
      margin-bottom: 22px;
    }

    .persona-meta {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .persona-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent) 0%, #6366f1 100%);
      display: grid;
      place-items: center;
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 14px;
      color: #fff;
    }

    .persona-name {
      font-weight: 600;
      font-size: 15px;
      color: #f3f4f6;
    }

    .persona-role {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
    }

    .hwb-question {
      font-family: var(--font-mono);
      font-size: clamp(14px, 1.4vw, 19px);
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* SCENE 4: VORTEX SOLUTION */
    .vortex-stage {
      position: relative;
      height: 300px;
      width: 100%;
      max-width: 820px;
      margin: 0 auto 28px auto;
      display: grid;
      place-items: center;
    }

    .vortex-core {
      width: 124px;
      height: 124px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--accent) 0%, rgba(255, 45, 122, 0.35) 45%, transparent 75%);
      border: 2px solid var(--accent);
      box-shadow: 0 0 55px var(--accent-glow), inset 0 0 25px var(--accent);
      position: relative;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      animation: pulseCore 3s ease-in-out infinite;
    }

    .vortex-core span {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: #fff;
      text-transform: uppercase;
      text-align: center;
      line-height: 1.1;
    }

    @keyframes pulseCore {
      0%, 100% { transform: scale(1); box-shadow: 0 0 45px var(--accent-glow); }
      50% { transform: scale(1.16); box-shadow: 0 0 75px rgba(255, 45, 122, 0.6); }
    }

    .absorbing-fragment {
      position: absolute;
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 6px 12px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #9ca3af;
      transition: all 1.3s cubic-bezier(0.7, 0, 0.3, 1);
      z-index: 2;
    }

    .f-pos-1 { top: 8%; left: 8%; }
    .f-pos-2 { top: 12%; right: 10%; }
    .f-pos-3 { bottom: 15%; left: 12%; }
    .f-pos-4 { bottom: 18%; right: 12%; }
    .f-pos-5 { top: 48%; left: 2%; }
    .f-pos-6 { top: 46%; right: 4%; }
    .f-pos-7 { top: 2%; left: 45%; }
    .f-pos-8 { bottom: 2%; left: 48%; }

    .scene.active.absorbed .absorbing-fragment {
      top: 50% !important;
      left: 50% !important;
      right: auto !important;
      bottom: auto !important;
      transform: translate(-50%, -50%) scale(0.05);
      opacity: 0;
    }

    .solution-punchline {
      text-align: center;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s ease 1.4s, transform 0.8s ease 1.4s;
    }

    .scene.active.absorbed .solution-punchline {
      opacity: 1;
      transform: translateY(0);
    }

    /* SCENE 5: DUAL LIVE DEMO */
    .dual-demo-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    @media (max-width: 900px) {
      .dual-demo-container {
        grid-template-columns: 1fr;
        gap: 16px;
      }
    }

    .demo-phone-card {
      background: #0f1118;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 18px;
      min-height: 400px;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    }

    .card-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 14px;
    }

    .card-role-badge {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 3px 8px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
    }

    .role-establishment { color: var(--gemini-cyan); border: 1px solid rgba(56, 189, 248, 0.3); }
    .role-freelance { color: var(--accent); border: 1px solid rgba(255, 45, 122, 0.3); }

    .demo-log-line {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.5;
      padding: 8px 10px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.03);
      margin-bottom: 8px;
      border-left: 2px solid var(--accent);
      opacity: 0;
      transform: translateY(8px);
      transition: all 0.3s ease;
    }

    .demo-log-line.active {
      opacity: 1;
      transform: translateY(0);
    }

    .shift-preview-box {
      margin-top: 10px;
      padding: 12px;
      background: rgba(255, 45, 122, 0.08);
      border: 1px dashed var(--accent);
      border-radius: 8px;
      font-size: 12px;
    }

    .match-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #10b981;
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 700;
    }

    .btn-replay-demo {
      align-self: flex-start;
      margin-top: 14px;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 8px 14px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-replay-demo:hover {
      border-color: var(--accent);
      color: #fff;
    }

    /* SCENE 6: ARCHITECTURE */
    .pipeline-wrapper {
      position: relative;
      margin: 36px 0 40px 0;
    }

    .pipeline-nodes {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      position: relative;
      z-index: 2;
    }

    @media (max-width: 768px) {
      .pipeline-nodes {
        grid-template-columns: 1fr;
      }
    }

    .pipeline-node {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 24px 20px;
      position: relative;
      overflow: hidden;
    }

    .node-num {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .node-title {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }

    .node-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.45;
    }

    .laser-track {
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 2px;
      background: rgba(255, 255, 255, 0.06);
      transform: translateY(-50%);
      z-index: 1;
    }

    .laser-beam {
      position: absolute;
      top: 0;
      left: -15%;
      width: 25%;
      height: 100%;
      background: linear-gradient(90deg, transparent, var(--accent), #fff, transparent);
      box-shadow: 0 0 12px var(--accent);
      animation: laserFlow 3.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes laserFlow {
      0% { left: -25%; opacity: 0; }
      15% { opacity: 1; }
      85% { opacity: 1; }
      100% { left: 105%; opacity: 0; }
    }

    .integrations-tray {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .int-badge {
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #9ca3af;
    }

    /* SCENE 7: VALUE METRICS */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(20px, 3vw, 40px);
      margin-bottom: clamp(28px, 4vh, 48px);
    }

    @media (max-width: 800px) {
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }

    .metric-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: clamp(20px, 3vw, 32px);
    }

    .metric-before {
      font-family: var(--font-mono);
      font-size: clamp(14px, 1.2vw, 17px);
      color: var(--text-dim);
      text-decoration: line-through;
      margin-bottom: 6px;
      display: block;
    }

    .metric-after {
      font-size: clamp(38px, 4.8vw, 68px);
      font-weight: 800;
      color: #fff;
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin-bottom: 8px;
    }

    .metric-after span.unit {
      font-size: 0.55em;
      color: var(--accent);
      font-weight: 700;
      margin-left: 3px;
    }

    .metric-label {
      font-size: 14px;
      color: var(--text-muted);
    }

    .trust-badges {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .trust-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: #d1d5db;
      padding: 6px 16px;
      border-radius: 8px;
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    /* SCENE 8: CLOSING */
    .cta-pill {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--accent);
