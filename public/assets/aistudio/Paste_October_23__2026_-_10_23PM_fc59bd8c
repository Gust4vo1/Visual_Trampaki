        <div class="audience-status" id="audienceStatusBadge">
          <span class="status-ping"></span>
          <span id="audienceStatusText">Conectando plateia...</span>
        </div>
      </div>

      <div class="clock-widget-group">
        <div class="time-block">
          <span class="time-label">Cena Atual</span>
          <span class="time-val" id="presSceneTimer">00:20</span>
        </div>
        <div class="time-block">
          <span class="time-label">Tempo Total Restante</span>
          <span class="time-val" id="presTotalTimer">03:00</span>
        </div>
        <div class="pacing-pill on-track" id="presPacingIndicator">No ritmo</div>
      </div>
    </header>

    <main class="pres-main">
      <section class="pres-left-pane">
        <div class="preview-frame-container" id="previewContainer">
          <iframe id="presPreviewFrame" title="Prévia ao vivo da Plateia" sandbox="allow-scripts allow-same-origin"></iframe>
        </div>
        <div class="next-scene-preview">
          <div class="next-scene-label">A Seguir</div>
          <div class="next-scene-title" id="presNextSceneName">02 / O Caos da Última Hora</div>
        </div>
      </section>

      <section class="pres-script-pane">
        <div class="script-scene-num" id="presScriptNum">CENA 01 / 08 · 20 SEGUNDOS</div>
        <h2 class="script-scene-heading" id="presScriptTitle">Gancho: O Custo da Urgência</h2>
        <div class="script-body" id="presScriptBody">
          <!-- Dynamically injected -->
        </div>
      </section>
    </main>

    <footer class="pres-footer">
      <div class="proportional-track" id="presProportionalTrack" title="Navegar diretamente entre cenas"></div>
      <div class="pres-controls">
        <div style="font-family: var(--font-mono); font-size: 13px; color: var(--text-muted);">
          Cena <span id="presCurrentIndexLabel" style="color: #fff; font-weight: 700;">1</span> de 8
        </div>
        <div class="ctrl-btns">
          <button class="btn-pres" onclick="prevScene()">← Anterior</button>
          <button class="btn-pres" onclick="togglePresenterTimer()" id="btnToggleTimer">⏸ Pausar Cronômetro (T)</button>
          <button class="btn-pres" onclick="resetPresentation()">↺ Reiniciar (R)</button>
          <button class="btn-pres primary" onclick="nextScene()">Próxima Cena →</button>
        </div>
      </div>
    </footer>
  </div>

  <!-- HELP MODAL -->
  <div id="helpModal" class="help-modal" role="dialog" aria-modal="true" aria-label="Atalhos do Teclado">
    <div class="help-card">
      <h3 style="font-size: 18px; margin-bottom: 16px; font-weight: 700;">Atalhos da Apresentação</h3>
      <div class="help-row"><span>Avançar cena</span><span><span class="key-badge">→</span> <span class="key-badge">Espaço</span> <span class="key-badge">Enter</span></span></div>
      <div class="help-row"><span>Voltar cena</span><span><span class="key-badge">←</span></span></div>
      <div class="help-row"><span>Modo Apresentador (nova janela)</span><span><span class="key-badge">P</span></span></div>
      <div class="help-row"><span>Tela cheia</span><span><span class="key-badge">F</span></span></div>
      <div class="help-row"><span>Pausar / Retomar Cronômetro</span><span><span class="key-badge">T</span></span></div>
      <div class="help-row"><span>Reiniciar Pitch</span><span><span class="key-badge">R</span></span></div>
      <div class="help-row"><span>Fechar esta ajuda</span><span><span class="key-badge">Esc</span> ou <span class="key-badge">?</span></span></div>
      <button class="btn-pres" style="width: 100%; margin-top: 18px; justify-content: center;" onclick="toggleHelp(false)">Fechar</button>
    </div>
  </div>

  <script>
    /* 1. SCENE TIMING & SPOKEN SCRIPT CONFIG (~430 WORDS) */
    const TOTAL_DURATION_SECONDS = 180;
    const SCENES_CONFIG = [
      {
        index: 0,
        title: "01 / A Provocação",
        name: "O Custo da Urgência",
        duration: 20,
        script: `
          <span class="stage-note">[OLHAR DIRETO PARA OS AVALIADORES · TOM ENÉRGICO]</span>
          Quantas vezes vocês já foram a um bar ou restaurante e a comida atrasou 40 minutos porque a equipe estava desfalcada?
          <span class="stage-note">[PAUSA DE 1 SEGUNDO]</span>
          Hoje, quando um funcionário falta numa sexta à noite, o dono do negócio leva <span class="key-phrase">três dias ligando para conhecidos ou implorando em grupos</span>.
          Com o Trampaki, esse mesmo turno crítico é preenchido e validado em <span class="key-phrase">exatos quatro minutos</span>.
        `
      },
      {
        index: 1,
        title: "02 / O Caos da Última Hora",
        name: "A Fragmentação do Setor",
        duration: 25,
        script: `
          <span class="stage-note">[GESTO APONTANDO PARA A NUVEM DE FRAGMENTOS À DIREITA]</span>
          Vejam a realidade do setor de hospitalidade e eventos hoje. Grupos lotados no WhatsApp, garçons que somem sem avisar e donos de bares desesperados às 19h45 de sábado.
          <span class="stage-note">[MUDANÇA DE TOM]</span>
          Do outro lado, <span class="key-phrase">milhares de profissionais qualificados querem trabalhar</span>, mas ficam reféns de calotes, atrasos de 30 dias para receber a diária e falta de garantias. É um mercado de bilhões operando no escuro.
        `
      },
      {
        index: 2,
        title: "03 / A Realidade da Persona",
        name: "A Dor do Ricardo",
        duration: 20,
        script: `
          Conheçam o Ricardo, dono de um bar movimentado em São Paulo.
          Ele nos disse com todas as letras: <span class="key-phrase">"Uma sexta-feira com dois garçons a menos custa 30% do faturamento da noite e destrói minha reputação no Google"</span>.
          <span class="stage-note">[AVANÇAR UM PASSO]</span>
          E isso nos levou ao nosso desafio no Google AI Studio: <span class="key-phrase">Como transformar uma emergência operacional em um turno preenchido e seguro antes da primeira comanda abrir?</span>
        `
      },
      {
        index: 3,
        title: "04 / O Ponto de Inflexão",
        name: "Apresentando o Trampaki",
        duration: 25,
        script: `
          <span class="stage-note">[OBSERVAR OS FRAGMENTOS SENDO ABSORVIDOS PELO NÚCLEO GEMINI]</span>
          E a nossa resposta é o <span class="key-phrase">Trampaki</span>.
          Nós conectamos estabelecimentos e autônomos em um marketplace sob demanda de altíssima velocidade.
          <span class="stage-note">[ENFATIZAR O MATCH INTELIGENTE]</span>
          Nosso motor neural alimentado pelo Google Gemini analisa reputação, histórico de pontualidade e distância geográfica para fazer o <span class="key-phrase">match perfeito sem atrito e sem intermediários burocráticos</span>.
        `
      },
      {
        index: 4,
        title: "05 / Simulação ao Vivo",
        name: "Demo Estabelecimento x Colaborador",
        duration: 35,
        script: `
          <span class="stage-note">[APONTAR PARA AS DUAS TELAS SINCRONIZADAS]</span>
          Vejam a mágica acontecendo na prática.
          À esquerda, o bar publica um turno urgente: Barman para hoje, R$ 180, das 19h às 2h da manhã. O Gemini AI valida a taxa justa e dispara o alerta em 2.5km.
          <span class="stage-note">[MOSTRAR A TELA DA DIREITA]</span>
          Na mesma fração de segundo, o Carlos recebe o card com 98% de compatibilidade. Ele aceita com um toque.
          O contrato temporário é gerado e o pagamento já fica garantido em escrow. <span class="key-phrase">Zero risco para quem contrata, zero risco para quem trabalha</span>.
        `
      },
      {
        index: 5,
        title: "06 / Arquitetura e IA",
        name: "Google AI Studio em Ação",
        duration: 20,
        script: `
          <span class="stage-note">[ACOMPANHAR O FEIXE DE LUZ DO PIPELINE]</span>
          Nossa infraestrutura foi construída sobre três pilares herméticos no ecossistema Google AI Studio.
          Triagem preventiva contra perfis falsos; algoritmo preditivo de match via Gemini 1.5 Pro; e liquidação instantânea via Pix com check-in auditado por cerca digital de GPS.
          <span class="key-phrase">É tecnologia de ponta aplicada à economia real</span>.
        `
      },
      {
        index: 6,
        title: "07 / Retorno Comprovado",
        name: "Métricas de Impacto",
        duration: 20,
        script: `
          <span class="stage-note">[DESTAQUE PARA OS NÚMEROS ANIMADOS]</span>
          Os números dos nossos primeiros pilotos falam por si:
          O tempo para cobrir um turno caiu de 48 horas para <span class="key-phrase">apenas 4 minutos</span>.
          A taxa de no-show desabou de 35% para <span class="key-phrase">menos de 3%</span>.
          E o colaborador recebe no mesmo minuto pelo Pix. Eliminamos a dor de cabeça e colocamos dinheiro no bolso de quem produz.
        `
      },
      {
        index: 7,
        title: "08 / Fechamento & CTA",
        name: "O Chamado para Ação",
        duration: 15,
        script: `
          <span class="stage-note">[CONTATO VISUAL FIRME · TOM DE ENCERRAMENTO CONFIANTE]</span>
          O futuro do trabalho flexível não pode depender da sorte ou de mensagens perdidas no WhatsApp.
          <span class="key-phrase">O trabalho flexível precisa de inteligência, dignidade e previsibilidade.</span>
          Estamos abrindo 10 vagas para a próxima turma de estabelecimentos parceiros em São Paulo.
          Venham falar conosco e vamos transformar a escala do seu negócio agora. Muito obrigado!
        `
      }
    ];

    /* 2. MODE DETECTION */
    const urlParams = new URLSearchParams(window.location.search);
    const isPresenter = urlParams.has('presenter');
    const isPreview = urlParams.has('preview');

    let currentSceneIndex = 0;
    const totalScenes = SCENES_CONFIG.length;

    function getModeUrl(paramKey) {
      const url = new URL(window.location.href);
      url.search = `?${paramKey}`;
      return url.toString();
    }

    /* 3. BROADCAST CHANNEL HANDSHAKE */
    let syncChannel = null;
    let lastAudiencePongTime = 0;

    try {
      syncChannel = new BroadcastChannel('trampaki_pitch_sync');
      syncChannel.onmessage = handleBroadcastMessage;
    } catch (e) {
      console.warn("BroadcastChannel indisponível:", e);
    }

    function handleBroadcastMessage(event) {
      const data = event.data;
      if (!data) return;

      if (data.type === 'NAVIGATE') {
        goToScene(data.scene, false);
      } else if (data.type === 'PING') {
        if (!isPresenter && syncChannel) {
          syncChannel.postMessage({ type: 'PONG', timestamp: Date.now() });
        }
      } else if (data.type === 'PONG') {
        if (isPresenter) {
          lastAudiencePongTime = Date.now();
          updateAudienceBadge(true);
        }
      }
    }

    function broadcastNavigation(sceneIndex) {
      if (!syncChannel || isPreview) return;
      syncChannel.postMessage({
        type: 'NAVIGATE',
        scene: sceneIndex,
        timestamp: Date.now()
      });
    }

    /* 4. INIT */
    window.addEventListener('DOMContentLoaded', () => {
      if (isPresenter) {
        document.body.classList.add('is-presenter-mode');
        initPresenterMode();
      } else if (isPreview) {
        document.body.classList.add('is-preview-mode');
      } else {
        showAudienceHint();
      }

      setupNavigationEvents();
      goToScene(0, false);
    });

    function showAudienceHint() {
      const hint = document.getElementById('audienceHint');
      if (!hint) return;
      hint.classList.add('visible');
      setTimeout(() => hint.classList.remove('visible'), 6000);
    }

    /* 5. NAVIGATION & SCENE DYNAMICS */
    function goToScene(index, shouldBroadcast = true) {
      if (index < 0 || index >= totalScenes) return;
      currentSceneIndex = index;

      const scenes = document.querySelectorAll('#audienceViewport .scene');
      scenes.forEach((sc, i) => {
        if (i === currentSceneIndex) {
          sc.classList.add('active');
          triggerSceneDynamics(i);
        } else {
          sc.classList.remove('active');
          resetSceneDynamics(i);
        }
      });

      if (isPresenter) {
        updatePresenterContent();
        sceneElapsedSeconds = 0;
        updatePresenterTimersUI();
      }

      if (shouldBroadcast) {
        broadcastNavigation(currentSceneIndex);
      }
    }

    function nextScene() {
      if (currentSceneIndex < totalScenes - 1) goToScene(currentSceneIndex + 1, true);
    }

    function prevScene() {
      if (currentSceneIndex > 0) goToScene(currentSceneIndex - 1, true);
    }

    function triggerSceneDynamics(index) {
      if (index === 3) {
        const sc3 = document.getElementById('scene-3');
        sc3.classList.remove('absorbed');
        void sc3.offsetWidth;
        setTimeout(() => sc3.classList.add('absorbed'), 260);
      }
      if (index === 4) {
        startDualDemoSimulation(false);
      }
      if (index === 6) {
        animateMetricCounters();
      }
    }

    function resetSceneDynamics(index) {
      if (index === 3) {
        document.getElementById('scene-3')?.classList.remove('absorbed');
      }
      if (index === 4) {
        clearDemoTimeouts();
      }
    }

    /* DUAL DEMO TIMELINE SIMULATION */
    let demoTimeouts = [];
    function clearDemoTimeouts() {
      demoTimeouts.forEach(t => clearTimeout(t));
      demoTimeouts = [];
    }

    function startDualDemoSimulation(isReplay) {
      clearDemoTimeouts();
      const logs = [
        document.getElementById('estLog1'),
        document.getElementById('freeLog1'),
        document.getElementById('estLog2'),
        document.getElementById('freeLog2'),
        document.getElementById('estLog3'),
        document.getElementById('freeLog3'),
        document.getElementById('estLog4'),
        document.getElementById('freeLog4')
      ];

      logs.forEach(l => l && l.classList.remove('active'));

      const schedule = [
        { el: 'estLog1', delay: isReplay ? 150 : 600 },
        { el: 'freeLog1', delay: isReplay ? 600 : 1200 },
        { el: 'estLog2', delay: isReplay ? 1100 : 1900 },
        { el: 'freeLog2', delay: isReplay ? 1600 : 2500 },
        { el: 'estLog3', delay: isReplay ? 2100 : 3100 },
        { el: 'freeLog3', delay: isReplay ? 2600 : 3700 },
        { el: 'estLog4', delay: isReplay ? 3200 : 4400 },
        { el: 'freeLog4', delay: isReplay ? 3600 : 4900 }
      ];

      schedule.forEach(item => {
        const t = setTimeout(() => {
          const domEl = document.getElementById(item.el);
          if (domEl) domEl.classList.add('active');
        }, item.delay);
        demoTimeouts.push(t);
      });
    }

    /* METRIC COUNTERS */
    function animateMetricCounters() {
      const counters = document.querySelectorAll('#scene-6 .counter');
      counters.forEach(counter => {
        const target = parseFloat(counter.getAttribute('data-target'));
        const duration = 1200;
        const start = performance.now();

        function step(now) {
          const progress = Math.min((now - start) / duration, 1);
          const easeOut = 1 - Math.pow(1 - progress, 2);
          counter.textContent = Math.round(easeOut * target);
          if (progress < 1) requestAnimationFrame(step);
          else counter.textContent = target;
        }
        requestAnimationFrame(step);
      });
    }

    /* 6. PRESENTER MODE ENGINE */
    let timerRunning = false;
    let elapsedTotalSeconds = 0;
    let sceneElapsedSeconds = 0;
    let timerInterval = null;

    function initPresenterMode() {
      const iframe = document.getElementById('presPreviewFrame');
      if (iframe) {
        iframe.src = getModeUrl('preview');
      }

      const container = document.getElementById('previewContainer');
      const updateFrameScale = () => {
        if (!container || !iframe) return;
        const containerWidth = container.clientWidth;
        const scale = containerWidth / 1600;
        iframe.style.transform = `scale(${scale})`;
      };
      updateFrameScale();
      window.addEventListener('resize', updateFrameScale);

      buildProportionalTrack();
      startPresenterTimer();
      updatePresenterContent();
      startAudienceHeartbeat();
    }

    function startAudienceHeartbeat() {
      if (!syncChannel) return;
      syncChannel.postMessage({ type: 'PING' });
      setInterval(() => {
        syncChannel.postMessage({ type: 'PING' });
        const isConnected = (Date.now() - lastAudiencePongTime) <= 1900;
        updateAudienceBadge(isConnected);
      }, 1500);
    }

    function updateAudienceBadge(connected) {
      const badge = document.getElementById('audienceStatusBadge');
      const text = document.getElementById('audienceStatusText');
      if (!badge || !text) return;

      if (connected) {
        badge.classList.remove('disconnected');
        text.textContent = "Plateia conectada";
      } else {
        badge.classList.add('disconnected');
        text.textContent = "Plateia não detectada";
      }
    }

    function buildProportionalTrack() {
      const track = document.getElementById('presProportionalTrack');
      if (!track) return;
      track.innerHTML = '';

      SCENES_CONFIG.forEach((sc, i) => {
        const seg = document.createElement('div');
        seg.className = 'track-segment';
        seg.style.width = `${(sc.duration / TOTAL_DURATION_SECONDS) * 100}%`;
        seg.title = `${sc.title} (${sc.duration}s)`;
        seg.onclick = () => goToScene(i, true);
        track.appendChild(seg);
      });
    }

    function updatePresenterContent() {
      const current = SCENES_CONFIG[currentSceneIndex];
      const next = SCENES_CONFIG[currentSceneIndex + 1];

      document.getElementById('presScriptNum').textContent = `CENA 0${currentSceneIndex + 1} / 0${totalScenes} · ${current.duration} SEGUNDOS`;
      document.getElementById('presScriptTitle').textContent = current.name;
      document.getElementById('presScriptBody').innerHTML = current.script;

      const nextLabel = document.getElementById('presNextSceneName');
      if (nextLabel) {
        nextLabel.textContent = next ? `${next.title} — ${next.name}` : "— Fim da Apresentação —";
      }

      const idxLabel = document.getElementById('presCurrentIndexLabel');
      if (idxLabel) idxLabel.textContent = (currentSceneIndex + 1).toString();

      const segments = document.querySelectorAll('.track-segment');
      segments.forEach((seg, i) => {
        seg.classList.remove('current', 'completed');
        if (i < currentSceneIndex) seg.classList.add('completed');
        else if (i === currentSceneIndex) seg.classList.add('current');
      });
    }

    function startPresenterTimer() {
      if (timerRunning) return;
      timerRunning = true;
      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        elapsedTotalSeconds++;
        sceneElapsedSeconds++;
        updatePresenterTimersUI();
      }, 1000);
    }

    function togglePresenterTimer() {
      const btn = document.getElementById('btnToggleTimer');
      if (timerRunning) {
        clearInterval(timerInterval);
        timerRunning = false;
        if (btn) btn.textContent = '▶ Retomar Cronômetro (T)';
      } else {
        startPresenterTimer();
        if (btn) btn.textContent = '⏸ Pausar Cronômetro (T)';
      }
    }

    function updatePresenterTimersUI() {
      const currentScene = SCENES_CONFIG[currentSceneIndex];
      const sceneBudget = currentScene.duration;
      const sceneRemaining = sceneBudget - sceneElapsedSeconds;

      const sceneTimerEl = document.getElementById('presSceneTimer');
      if (sceneTimerEl) {
        sceneTimerEl.classList.remove('yellow', 'red');
        if (sceneRemaining > 5) {
          sceneTimerEl.textContent = formatClock(sceneRemaining);
        } else if (sceneRemaining >= 0) {
          sceneTimerEl.classList.add('yellow');
          sceneTimerEl.textContent = formatClock(sceneRemaining);
        } else {
          sceneTimerEl.classList.add('red');
          sceneTimerEl.textContent = `+${Math.abs(sceneRemaining)}s`;
        }
      }

      const totalRemaining = Math.max(0, TOTAL_DURATION_SECONDS - elapsedTotalSeconds);
      const totalTimerEl = document.getElementById('presTotalTimer');
      if (totalTimerEl) {
        totalTimerEl.textContent = formatClock(totalRemaining);
        if (totalRemaining === 0) totalTimerEl.classList.add('red');
      }

      let targetElapsedAtCurrent = 0;
      for (let i = 0; i <= currentSceneIndex; i++) {
        targetElapsedAtCurrent += SCENES_CONFIG[i].duration;
      }
      const idealAtMoment = targetElapsedAtCurrent - (sceneBudget - sceneElapsedSeconds);
      const diff = elapsedTotalSeconds - idealAtMoment;

      const pacingEl = document.getElementById('presPacingIndicator');
      if (pacingEl) {
        pacingEl.className = 'pacing-pill';
        if (diff > 5) {
          pacingEl.classList.add('behind');
          pacingEl.textContent = `Atrasado · acelere (+${diff}s)`;
        } else if (diff < -5) {
          pacingEl.classList.add('ahead');
          pacingEl.textContent = `Adiantado · respire (${diff}s)`;
        } else {
          pacingEl.classList.add('on-track');
          pacingEl.textContent = "No ritmo";
        }
      }
    }

    function formatClock(seconds) {
      const s = Math.max(0, seconds);
      const m = Math.floor(s / 60);
      const rem = s % 60;
      return `${String(m).padStart(2, '0')}:${String(rem).padStart(2, '0')}`;
    }

    function resetPresentation() {
      elapsedTotalSeconds = 0;
      sceneElapsedSeconds = 0;
      goToScene(0, true);
      if (isPresenter) updatePresenterTimersUI();
    }

    /* 7. EVENTS & SHORTCUTS */
    function setupNavigationEvents() {
      window.addEventListener('keydown', (e) => {
        const modal = document.getElementById('helpModal');
        if (modal && modal.classList.contains('open')) {
          if (e.key === 'Escape' || e.key === '?') {
            toggleHelp(false);
            return;
          }
        }

        switch (e.key) {
          case 'ArrowRight':
          case ' ':
          case 'Enter':
            e.preventDefault();
            nextScene();
            break;
          case 'ArrowLeft':
            e.preventDefault();
            prevScene();
            break;
          case 'p':
          case 'P':
            e.preventDefault();
            openPresenterWindow();
            break;
          case 'f':
          case 'F':
            e.preventDefault();
            toggleFullscreen();
            break;
          case 't':
          case 'T':
            if (isPresenter) {
              e.preventDefault();
              togglePresenterTimer();
            }
            break;
          case 'r':
          case 'R':
            e.preventDefault();
            resetPresentation();
            break;
          case '?':
            e.preventDefault();
            toggleHelp();
            break;
        }
      });

      let startX = 0, startY = 0;
      window.addEventListener('touchstart', (e) => {
        startX = e.changedTouches[0].screenX;
        startY = e.changedTouches[0].screenY;
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].screenX - startX;
        const dy = e.changedTouches[0].screenY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) nextScene();
          else prevScene();
        }
      }, { passive: true });
    }

    function openPresenterWindow() {
      const presenterUrl = getModeUrl('presenter');
      window.open(presenterUrl, 'TrampakiPresenterConsole', 'width=1280,height=850,menubar=no,toolbar=no,location=no');
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else if (document.exitFullscreen) {
        document.exitFullscreen();
      }
    }

    function toggleHelp(force) {
      const modal = document.getElementById('helpModal');
      if (!modal) return;
      if (typeof force === 'boolean') modal.classList.toggle('open', force);
      else modal.classList.toggle('open');
    }

    function triggerPilotNotice() {
      const toast = document.createElement('div');
      toast.style.cssText = `
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: #11131a;
        color: #fff;
        padding: 14px 28px;
        border-radius: 999px;
        border: 1px solid var(--accent);
        box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        font-family: var(--font-mono);
        font-size: 13px;
        z-index: 9999;
      `;
      toast.textContent = "✓ Piloto solicitado com sucesso! Nossa equipe do Trampaki entrará em contato hoje.";
